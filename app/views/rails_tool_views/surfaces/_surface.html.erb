<section id="<%= surface.dom_id %>" class="rails-tool-views-surface" data-controller="rails-tool-views" data-rails-tool-views-revision-value="<%= surface.revision %>" data-rails-tool-views-saving-value="<%= rails_tool_views_text(:saving) %>" data-rails-tool-views-failed-value="<%= rails_tool_views_text(:save_failed) %>" aria-label="<%= rails_tool_views_component_name(definition.key) %>" aria-describedby="<%= surface.dom_id %>_status">
  <%= rails_tool_views_body(surface, definition, error: error) %>
  <% if error %>
    <p id="<%= surface.dom_id %>_error" role="alert" tabindex="-1" data-rails-tool-views-target="error"><%= error.message %></p>
  <% end %>
  <p id="<%= surface.dom_id %>_status" role="status" aria-live="polite" tabindex="-1" data-rails-tool-views-target="status">
    <%= notice || (surface.state["message"].is_a?(String) ? surface.state["message"] : rails_tool_views_text(surface.revision > 1 ? :saved : :ready)) %>
  </p>
  <% interaction = surface.agent_interactions.order(:id).last %>
  <% if interaction && interaction.status != "skipped" %>
    <p role="status"><%= rails_tool_views_text({ "pending" => :agent_pending, "delivering" => :agent_pending, "completed" => :agent_completed, "failed" => :agent_failed, "abandoned" => :agent_abandoned }.fetch(interaction.status, :agent_unavailable)) %></p>
    <% if interaction.status == "failed" %>
      <%= form_with url: rails_tool_views_routes.surface_continuation_path(surface, interaction_id: interaction.id), method: :post do %>
        <button type="submit"><%= rails_tool_views_text(:agent_retry) %></button>
      <% end %>
    <% end %>
  <% end %>
  <p class="rails-tool-views-revision"><%= rails_tool_views_text(:revision, revision: surface.revision) %></p>
</section>
