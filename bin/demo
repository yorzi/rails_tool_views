#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
# The agent chat page needs RubyLLM, so the demo runs on the adapter bundle.
# The rest of the demo also runs under the core Gemfile.
export BUNDLE_GEMFILE="${BUNDLE_GEMFILE:-$PWD/gemfiles/adapter.gemfile}"
bundle check >/dev/null || bundle install
bundle exec rake demo:prepare
exec bundle exec ruby test/dummy/bin/rails server -b 127.0.0.1 -p "${PORT:-3100}"
