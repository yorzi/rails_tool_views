<header class="demo-header">
  <p class="demo-eyebrow">TOOLVIEWS · V1 REFERENCE WORKFLOWS</p>
  <h1>Trusted views.<br>Real domain actions.</h1>
  <p class="demo-lead">Correct a draft, review a reply, or accept a version. Rails remains in charge.</p>
  <p class="demo-meta">Offline fixture · <%= @staff.tenant_ref.capitalize %> tenant · <%= @staff.role %> · no external messages</p>
</header>
<nav class="v1-navigation" aria-label="Reference workflows">
  <% if @staff.role == "lead" %><%= link_to "Customer form", v1_customer_path %><% end %>
  <%= link_to "Support tickets", v1_support_path %>
  <%= link_to "Result review", v1_review_path %>
  <%= link_to "V0 ChoiceCard", root_path %>
</nav>
<%= form_with url: v1_identity_path, method: :post, data: { turbo: false }, class: "v1-identity" do %>
  <%= label_tag "demo_identity", "Demo identity" %>
  <%= select_tag :code, options_for_select(DemoStaff.where(active: true).order(:code).map { |staff| [staff.name, staff.code] }, @staff.code), id: "demo_identity" %>
  <button type="submit">Switch identity</button>
<% end %>
