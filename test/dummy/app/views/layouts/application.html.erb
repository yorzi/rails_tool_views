<!DOCTYPE html>
<html lang="en">
<head>
  <title>RailsToolViews · Local reference workflows</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <%= csrf_meta_tags %>
  <%= stylesheet_link_tag "demo" %>
  <%= javascript_include_tag "turbo", type: "module" %>
  <%= javascript_tag type: "module", nonce: true do %>
    import { Application, Controller } from "<%= asset_path('stimulus.js') %>";
    import railsToolViewsController from "<%= asset_path('rails_tool_views_controller.js') %>";
    const app = Application.start();
    app.register("rails-tool-views", railsToolViewsController(Controller));
  <% end %>
</head>
<body>
  <a class="skip-link" href="#workspace">Skip to workspace</a>
  <div class="app-shell">
    <aside class="app-sidebar">
      <%= link_to root_path, class: "app-brand" do %><span class="brand-mark" aria-hidden="true">▤</span><span>RailsToolViews<small>INTERACTIVE WORKBENCH</small></span><% end %>
      <p class="nav-label">EXPLORE THE DEMO</p>
      <nav class="app-nav" aria-label="Demo workflows">
        <% [["01", "Component playground", root_path], ["02", "Customer intake", v1_customer_path], ["03", "Support workspace", v1_support_path], ["04", "Content review", v1_review_path]].each do |number, label, path| %>
          <% next if path == v1_customer_path && @staff && @staff.role != "lead" %>
          <%= link_to path, aria: { current: request.path == path ? "page" : nil } do %><span><%= number %></span><%= label %><% end %>
        <% end %>
      </nav>
      <div class="sidebar-note"><span class="live-dot"></span> Runs entirely locally<p>Real Rails actions.<br>Persistent UI state.<br>No API keys needed.</p></div>
      <p class="sidebar-version">v<%= RailsToolViews::VERSION %><br>Unpublished development preview</p>
    </aside>
    <div class="app-content">
      <div class="app-topbar"><span>REFERENCE APPLICATION <span class="topbar-divider">/</span> DEMO</span><span class="offline-pill"><span class="live-dot"></span> Offline fixtures</span></div>
      <main id="workspace"><%= yield %></main>
      <footer class="app-footer">Built with trusted Rails components <span>Local fixtures · No external messages</span></footer>
    </div>
  </div>
</body>
</html>
