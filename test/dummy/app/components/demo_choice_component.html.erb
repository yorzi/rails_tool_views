<h2><%= @title %></h2>
<p class="demo-muted">Trusted ViewComponent · <%= @options.length %> options</p>
<%= tool_views_action_form(@surface, :select_option) do |form| %>
  <fieldset aria-describedby="<%= @surface.dom_id %>_status">
    <legend>Choose a workflow</legend>
    <% @options.each do |option| %>
      <%= form.label :key, value: option.fetch("key"), class: "demo-option" do %>
        <%= form.radio_button :key, option.fetch("key"), checked: @state["selected"] == option["key"], required: true %>
        <span><%= option.fetch("label") %></span>
      <% end %>
    <% end %>
  </fieldset>
  <%= form.submit "Save selection" %>
<% end %>
